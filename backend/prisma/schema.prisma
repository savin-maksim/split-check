// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  checks    Check[]
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Check {
  id          String    @id @default(uuid())
  title       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  people      Person[]
  costs       Cost[]
  isPublic    Boolean   @default(false)
  shareLinks  ShareLink[]
}

model Person {
  id          String   @id @default(uuid())
  name        String
  check       Check?   @relation(fields: [checkId], references: [id], onDelete: SetNull)
  checkId     String?
  costs       Cost[]   @relation("PaidBy")
  splitCosts  Cost[]   @relation("SplitBetween")
  groups      Group[]
}

model Cost {
  id            String   @id @default(uuid())
  title         String
  quantity      Int      @default(1)
  pricePerUnit  Float
  amount        Float    @default(0)
  check         Check    @relation(fields: [checkId], references: [id])
  checkId       String
  paidBy        Person[] @relation("PaidBy")
  splitBetween  Person[] @relation("SplitBetween")
  createdAt     DateTime @default(now())
}

model Group {
  id        String   @id @default(uuid())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  members   Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShareLink {
  id        String   @id @default(uuid())
  check     Check    @relation(fields: [checkId], references: [id])
  checkId   String
  type      String   // 'readonly' или 'interactive'
  token     String   @unique
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
} 